# PHPStan, as this repo's PHP *compatibility* gate.
#
# `npm run lint:php` parses every tracked file with PHP 7.4, the floor the plugin
# header declares. That is a parser and nothing else: it holds the bottom of the
# supported range — PHP 8-only syntax cannot reach a release claiming 7.4 — and
# says nothing at all about the top of it, where the hazards are runtime rather
# than syntax. Functions removed in 8.x, dynamic property creation, `null` into
# an internal non-nullable parameter and implicit float-to-int precision loss all
# lint clean on 7.4 and break, or warn, on a modern host. Linting on 8.4 as well
# would not find them either: almost no syntax was removed in 8.x, so a second
# parser adds noise instead of coverage.
#
# `phpVersion` below is what does find them. It is the whole span the plugin
# claims — 7.4, the declared floor, through 8.4, the newest release hosts offer —
# and PHPStan reports anything that breaks anywhere inside it, from one analysis
# on whatever PHP the developer happens to have.
#
# The test suite here covers a handful of behaviours, so this and the lint are
# still the only nets an incompatibility can fall into. Both of them run on every
# pull request — `.github/workflows/ci.yml`.
#
# `npm run analyse:php` passes `--memory-limit=2G` rather than inheriting
# `php.ini`. The stubs below are one 5.3 MB file, and holding its syntax tree
# peaks a parallel worker somewhere between 832M and 896M — so on PHP's default
# 128M the analysis does not report findings at all: it dies in a worker, and
# what comes back is a crash notice naming the limit, or a bare exit code that
# mentions no such thing (#96). It only reproduces on a cold result cache, which
# is why it went unnoticed: `vendor/bin/phpstan clear-result-cache` is what
# makes it deterministic. Pinning the number is also what makes this gate's
# verdict independent of the ini it runs under — a CI runner's and a
# developer's disagreed until it did. ADR 0020; override it for one run with
# `npm run analyse:php -- --memory-limit=…`.

includes:
	# WordPress core's functions, classes, constants and hooks, as stubs. Without
	# them every `add_action()` in the plugin is an unknown function and the real
	# findings drown.
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	# What the files in include/ were already carrying the day they were first
	# analysed. Read phpstan-baseline.neon as a to-do list, never as settings:
	# fix a finding and the gate asks you to regenerate the file
	# (`vendor/bin/phpstan analyse --memory-limit=-1 --generate-baseline
	# phpstan-baseline.neon`), so the list can only get shorter. Nothing new
	# belongs in it. The limit is there for the same reason `analyse:php` pins
	# one — a regeneration re-parses the stubs, so on a default `php.ini` it
	# fatals rather than writing a baseline (#96) — and it is `-1` rather than
	# the gate's `2G` because this is a one-off run by hand, where the point is
	# to finish. ADR 0009 has the full sequence.
	#
	# Regenerate it only where every extension the code uses is loaded. PHPStan
	# cannot report on a function whose extension is absent, so a baseline
	# generated in a stripped environment silently *drops* entries and turns CI
	# red. That has happened exactly once — the harness sandbox has no ext-curl,
	# and the `curl_setopt` entry went with it. Nothing to do with `phpVersion`
	# below: that finding reproduces on 7.4 and 8.3 alike. ADR 0009 has it.
	#
	# It was regenerated once, in #75, and that is the only reason it has ever
	# grown: #69 generated it on a branch cut before #70 and merged it after, so
	# the committed list described a tree `main` never had and the analysis was
	# red from the moment it landed. See
	# docs/adr/0009-checks-run-on-pull-requests.md — a regeneration is what an
	# out-of-date baseline needs, and it is not licence to bank a new finding.
	#
	# It shrank in #82, from 25 entries to 4. Eighteen of the twenty-one that
	# left were one shape — the magic `__get()` accessors, whose surface
	# `NextJsRevalidate` and each class extending `Abstracts\Base` now declare in
	# `@property` docblocks, so the analysis can see what it used to be told to
	# ignore; the other three were two lying docblocks and a redundant
	# `method_exists()`. Anything still in the file is unrelated to either and
	# still a to-do.
	# See docs/adr/0026-the-magic-property-surface-is-declared.md.
	- phpstan-baseline.neon

parameters:
	# Level 5 adds argument types to the levels below it, which is where the
	# compatibility findings live. Raising it is a separate piece of work: it
	# lengthens the baseline rather than the gate.
	level: 5

	paths:
		- include
		# The plugin file itself: the composition root, the two public API
		# functions and the activation hooks all live in it, and it ships.
		- nextjs-revalidate.php
		# The WordPress floor rule, which ships nothing but is loaded into every
		# run. PHPStan only notices an edit to an extension it analyses: outside
		# these paths, a changed rule leaves a stale result cache and a warning
		# that fails the run. The file alone, not config/phpstan — the canary
		# fixture beside it is meant to fail and is analysed on its own (ADR 0030).
		- config/phpstan/WordPressFloorRule.php

	# A `{min, max}` range, not a single version. PHPStan 2.x is what supports
	# this shape — an older major reads `phpVersion` as one int and would analyse
	# a single point in the range — so composer.json pins `^2.2`.
	phpVersion:
		min: 70400
		max: 80400

	# The WordPress release the plugin declares as its floor — `Requires at least`
	# in nextjs-revalidate.php and readme.txt, and "Requires WordPress" in
	# README.md — and what `WordPressFloorRule` below holds every core function,
	# method and class the plugin calls to. A call to anything core documents as
	# `@since` a newer release fails the analysis, naming the API and the release.
	#
	# It is a copy of the header, and deliberately: PHPStan's result cache is keyed
	# on this file, so a floor read from the header would leave every cached
	# verdict standing when only the header moved. `tests/wordpress-floor-test.php`
	# fails when any of the four disagree, so moving the floor is one edit in each
	# and the gate refuses anything less. `MAJOR.MINOR`, for the reason ADR 0028
	# gives. Hooks are outside what the rule can see, and
	# `config/phpstan/floor-canary/` proves the rule still reports before each
	# analysis trusts it — ADR 0030.
	wordpressFloor: '5.6'

parametersSchema:
	wordpressFloor: string()

services:
	-
		class: NextJsRevalidate\PHPStan\WordPressFloorRule
		arguments:
			floor: %wordpressFloor%
		tags:
			- phpstan.rules.rule
