# Container auth to Claude. Copy this file to `.sandcastle/.env` — which is
# gitignored — and fill in ONE of the two keys below.
#
# sandcastle forwards only the keys *named in that file*. A key you export in
# your shell but do not name here never reaches the container, so leave both
# lines present even when you fill in only one: an empty value means "take it
# from the environment running the harness".
#
# Nothing secret is baked into the sandbox image; the value arrives as a
# `docker run -e` when the container starts.

# From `claude setup-token` on the host. Bills your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Or an API key instead, billing the API account.
ANTHROPIC_API_KEY=
