{
  "name": "nextjs-revalidate-sandcastle",
  "version": "0.0.0",
  "private": true,
  "description": "AFK agent harness for nextjs-revalidate. Deliberately kept out of the plugin's dependency tree.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dry-run": "node run.mts --dry-run",
    "plan": "node run.mts --plan",
    "prepare-branches": "node run.mts --prepare",
    "implement": "node run.mts --implement",
    "finalize": "node run.mts --finalize",
    "test": "node --test 'test/**/*.test.mts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
