"un administrateur."

#: include/Revalidate.php:487
#, php-format
msgid "%d cache will be purged shortly."
msgid_plural "%d caches will be purged shortly."
msgstr[0] "%d cache sera bientôt purgé."
msgstr[1] "%d caches seront bientôt purgés."

#: include/RevalidateAll.php:45
msgctxt "Admin top bar menu"
msgid "All"
msgstr "Tout"

#: include/RevalidateAll.php:70
msgctxt "Admin top bar menu"
msgid ""
"Purging all cache may take some time according to the number of pages to "
