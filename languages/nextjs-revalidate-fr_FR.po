#: include/Settings.php:606
msgid ""
"Next.js revalidate is not configured for this site: the revalidate domain "
"and secret are both required before anything can be revalidated."
msgstr ""
"Next.js revalidate n'est pas configurée pour ce site : le domaine et la clé "
"secrète de revalidation sont tous deux obligatoires avant de pouvoir "
"procéder à une revalidation."

#: include/Settings.php:627
msgid "its revalidate domain and secret are missing"
msgstr "le domaine et le secret de revalidation sont manquants"

#: include/Settings.php:628
msgid "its revalidate domain is missing"
msgstr "le domaine de revalidation est manquant"

#: include/Settings.php:629
msgid "its secret is missing"
msgstr "le secret de revalidation est manquant"

#. translators: %s: which of the two required settings are missing.
#: include/Settings.php:634
#, php-format
msgid ""
"Next.js revalidate is not configured for this site — %s. Content is still "
"saved, but every revalidation is refused: the front-end is never asked to "
"rebuild its pages."
msgstr ""
"Next.js revalidate n'est pas configurée pour ce site — %s. Le contenu est "
"toujours enregistré, mais chaque revalidation est refusée : le front-end "
"n'est jamais invité à reconstruire ses pages."

#: include/Settings.php:645
msgid "Configure Next.js revalidate"
msgstr "Configurer Next.js revalidate"

#. translators: %s: number of sites on the network.
