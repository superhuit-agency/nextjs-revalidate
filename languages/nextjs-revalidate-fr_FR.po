#. Plugin Name of the plugin
#: nextjs-revalidate.php include/Settings.php:158
msgid "Next.js revalidate"
msgstr "Next.js revalidate"

#. Plugin URI of the plugin
#: nextjs-revalidate.php
msgid "https://github.com/superhuit-agency/nextjs-revalidate.git"
msgstr "https://github.com/superhuit-agency/nextjs-revalidate.git"

#. Description of the plugin
#: nextjs-revalidate.php
msgid ""
"Next.js plugin allows you to purge & re-build the cached pages from the "
"WordPress admin area. It also automatically purges & re-builds when a page/"
"post/... is save or updated."
msgstr ""
"Le plugin Next.js Revalidate vous permet de purger et de reconstruire les "
"pages en cache depuis la zone d’administration de WordPress. Il purge et "
"reconstruit aussi automatiquement lorsqu’une page/post/… est sauvegardée ou "
"mise à jour."

#. Author of the plugin
#: nextjs-revalidate.php
msgid "superhuit"
msgstr "superhuit"

#. Author URI of the plugin
#: nextjs-revalidate.php
msgid "https://www.superhuit.ch"
msgstr "https://www.superhuit.ch"

#. translators: 1: number of failed revalidations. 2: number of attempts on record.
#: include/FailureWindow.php:264
#, php-format
msgid ""
"Next.js revalidate is not keeping this site up to date — %1$d of the last "
"%2$d revalidations failed. Content is still saved, but the front-end is "
"serving pages which are quietly out of date."
msgstr ""
"Next.js revalidate ne parvient pas à maintenir ce site à jour : %1$d des "
"%2$d dernières purges ont échoué. Le contenu est toujours enregistré, mais "
"le front-end affiche des pages qui sont, sans que l'on s'en rende compte, "
"obsolètes."

#. translators: %s: the cause of the most recent failure.
#: include/FailureWindow.php:273
#, php-format
msgid "Most recent error: %s."
msgstr "Dernière erreur : %s."

#: include/FailureWindow.php:279
msgid "Other errors occurred as well."
msgstr "D'autres erreurs se sont également produites."

#: include/FailureWindow.php:284 include/Settings.php:649
msgid "Please contact a site administrator."
msgstr "Veuillez contacter un administrateur du site."

#: include/FailureWindow.php:295
msgid "Check the Next.js revalidate settings"
msgstr "Vérifier les paramètres Next.js Revalidate"

#: include/FailureWindow.php:404
msgid "the front-end could not be reached"
msgstr "impossible d'accéder au Frontend"

#: include/FailureWindow.php:407
msgid "the front-end rejected the secret"
msgstr "le front-end a rejeté le secret"

#. translators: %s: an HTTP status code, e.g. 500.
#: include/FailureWindow.php:412
#, php-format
msgid "the front-end answered %s"
msgstr "le front-end a répondu %s"

#: include/Revalidate.php:193
msgid "The front-end answered without a status code."
msgstr "Le front-end a répondu sans code d'état."

#. translators: %d: the HTTP status code the front-end answered with.
#: include/Revalidate.php:199
#, php-format
msgid "The front-end answered %d."
msgstr "The front-end answered %d."

