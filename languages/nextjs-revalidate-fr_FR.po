#: include/RevalidateAll.php:87
msgid "Revalidate all: nothing was queued, this site is not configured."
msgstr ""
"Tout purger : aucun élément n'était en file d'attente, ce site n'est pas "
"configuré."

#: include/RevalidateAll.php:97
#, php-format
msgid ""
"Purge all: %d pages added to purge. Please wait until all pages are purged."
msgstr ""
"Purger tout : %d pages ajoutées à la file d’attente. Veuillez attendre que "
"toutes les pages soient purgées."

#: include/RevalidateQueue.php:372
#, php-format
msgid "Purging caches. Please wait… %s%s"
msgstr ""
"La purge des pages est en cours d’exécution. Veuillez patienter... %s%s"

#: include/RevalidateQueue.php:378
msgid "View purge caches queue"
msgstr "Afficher la file d’attente de purge de cache"

#: include/RevalidateQueue.php:387
