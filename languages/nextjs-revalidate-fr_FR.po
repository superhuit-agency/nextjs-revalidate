#. Plugin Name of the plugin
#: nextjs-revalidate.php include/Settings.php:226
msgid "Next.js Revalidate"
msgstr "Next.js Revalidate"

#. Plugin URI of the plugin
#: nextjs-revalidate.php
msgid "https://github.com/superhuit-agency/nextjs-revalidate.git"
msgstr "https://github.com/superhuit-agency/nextjs-revalidate.git"

#. Description of the plugin
#: nextjs-revalidate.php
msgid ""
"Tells a Next.js front-end which WordPress content changed — posts, menus, "
"templates, redirects — so it can revalidate whatever it cached from it, on "
"save and from the admin."
msgstr ""
"Indique à un front-end Next.js quels contenus WordPress ont changé — "
"articles, menus, modèles, redirections — afin qu’il puisse revalider tout ce "
"qu’il en a mis en cache, à l’enregistrement et depuis l’administration."

#. Author of the plugin
#: nextjs-revalidate.php
msgid "superhuit"
msgstr "superhuit"

#. Author URI of the plugin
#: nextjs-revalidate.php
msgid "https://www.superhuit.ch"
msgstr "https://www.superhuit.ch"

#. translators: 1: number of failed revalidations. 2: number of attempts on record.
#: include/FailureWindow.php:288
#, php-format
msgid ""
"Next.js Revalidate is not keeping this site up to date — %1$d of the last "
"%2$d revalidations failed. Content is still saved, but the front-end is "
"serving pages which are quietly out of date."
msgstr ""
"Next.js Revalidate ne parvient pas à maintenir ce site à jour : %1$d des "
"%2$d dernières revalidations ont échoué. Le contenu est toujours enregistré, "
"mais le front-end affiche des pages qui sont, sans que l'on s'en rende "
"compte, obsolètes."

#. translators: %s: the cause of the most recent failure.
#: include/FailureWindow.php:297
#, php-format
msgid "Most recent error: %s."
msgstr "Dernière erreur : %s."

#: include/FailureWindow.php:303
msgid "Other errors occurred as well."
msgstr "D'autres erreurs se sont également produites."

#: include/FailureWindow.php:308 include/Settings.php:805
msgid "Please contact a site administrator."
msgstr "Veuillez contacter un administrateur du site."

#: include/FailureWindow.php:319
msgid "Check the Next.js Revalidate settings"
msgstr "Vérifier les paramètres Next.js Revalidate"

#: include/FailureWindow.php:428
msgid "the front-end could not be reached"
msgstr "impossible d'accéder au Frontend"

#: include/FailureWindow.php:431
msgid "the front-end rejected the secret"
msgstr "le front-end a rejeté le secret"

#. translators: %s: an HTTP status code, e.g. 500.
#: include/FailureWindow.php:436
#, php-format
msgid "the front-end answered %s"
msgstr "le front-end a répondu %s"

#: include/LogViewer.php:75
msgid "Sorry, you are not allowed to read the log of this site."
msgstr "Désolé, vous n’êtes pas autorisé(e) à lire le journal de ce site."

#: include/LogViewer.php:85 include/LogViewer.php:111
msgid "This page has expired. Reload it to refresh the log."
msgstr "Cette page a expiré. Rechargez-la pour actualiser le journal."

#: include/LogViewer.php:108
msgid "Live refresh stopped: logging has been switched off."
msgstr "Actualisation en direct arrêtée : la journalisation a été désactivée."

#: include/LogViewer.php:109
msgid ""
"Live refresh stopped: this page has expired. Reload it to refresh the log."
msgstr "Actualisation en direct arrêtée : cette page a expiré. Rechargez-la pour actualiser le journal."

#: include/LogViewer.php:110
msgid "Live refresh stopped: the log could not be refreshed."
msgstr "Actualisation en direct arrêtée : le journal n’a pas pu être actualisé."

#: include/LogViewer.php:112
msgid "The log could not be refreshed."
msgstr "Le journal n’a pas pu être actualisé."

#: include/LogViewer.php:123
msgid "Refresh"
msgstr "Actualiser"

#: include/LogViewer.php:131
msgid "Live refresh, every 5 seconds"
msgstr "Actualisation en direct, toutes les 5 secondes"

#: include/LogViewer.php:153
msgid ""
"Logging has been switched off since this page was loaded, so there is no log "
"to show. Reload the page to see the Debug tab as it is saved."
msgstr "La journalisation a été désactivée depuis le chargement de cette page : il n’y a aucun journal à afficher. Rechargez la page pour voir l’onglet Débogage tel qu’il est enregistré."

#. translators: %s: the time the log was read, e.g. 14:05:09
#: include/LogViewer.php:166
#, php-format
msgid "Nothing has been logged yet — refreshed %s"
msgstr "Rien n’a encore été journalisé — actualisé à %s"

#. translators: 1: how many lines are shown, 2: how many lines the log holds, 3: the size of the log, e.g. 1.2 MB, 4: the time the log was read, e.g. 14:05:09
#: include/LogViewer.php:175
#, php-format
msgid "Showing the last %1$s of %2$s line (%3$s) — refreshed %4$s"
msgid_plural "Showing the last %1$s of %2$s lines (%3$s) — refreshed %4$s"
msgstr[0] "Affichage de %1$s ligne sur %2$s (%3$s) — actualisé à %4$s"
msgstr[1] "Affichage des %1$s dernières lignes sur %2$s (%3$s) — actualisé à %4$s"

#: include/LogViewer.php:190
msgid "The end of the log file"
msgstr "La fin du fichier journal"

#: include/Probe.php:111
msgid "Sorry, you are not allowed to probe the front-end of this site."
msgstr "Désolé, vous n’êtes pas autorisé(e) à sonder le front-end de ce site."

#. translators: %s: the permalink nothing was sent for.
#: include/Probe.php:217
#, php-format
msgid ""
"Nothing was sent for %s: this site's nextjs_revalidate_change filter dropped "
"the change."
msgstr ""
"Rien n’a été envoyé pour %s : le filtre nextjs_revalidate_change de ce site "
"a écarté le changement."

#. translators: %s: the permalink the front-end was asked to rebuild.
#: include/Probe.php:228
#, php-format
msgid "The front-end rebuilt %s."
msgstr "Le front-end a reconstruit %s."

#. translators: 1: the permalink nothing was sent for. 2: why nothing was sent.
#: include/Probe.php:242
#, php-format
msgid "Nothing was sent for %1$s. %2$s"
msgstr "Rien n’a été envoyé pour %1$s. %2$s"

#. translators: 1: the permalink. 2: what the attempt answered. 3: the error code.
#: include/Probe.php:253
#, php-format
msgid "The front-end did not rebuild %1$s — %2$s (%3$s)"
msgstr "Le front-end n’a pas reconstruit %1$s — %2$s (%3$s)"

#: include/Probe.php:349
msgid "Probe the front-end"
msgstr "Sonder le front-end"

#: include/Probe.php:351
msgid ""
"Ask the front-end to rebuild one path now, and see what it answers — "
"including the error, when there is one."
msgstr ""
"Demander au front-end de reconstruire un chemin maintenant, et voir ce qu’il "
"répond — y compris l’erreur, s’il y en a une."

#: include/Probe.php:355
msgid "Path to revalidate"
msgstr "Chemin à revalider"

#: include/Probe.php:366
msgid ""
"A path of this site, such as <code>/hello-world/</code>. The page is really "
"rebuilt, exactly as it would be after an edit — this is not a dry run."
msgstr ""
"Un chemin de ce site, comme <code>/hello-world/</code>. La page est "
"réellement reconstruite, exactement comme après une modification — ce n’est "
"pas un essai à blanc."

#: include/Probe.php:369
msgid ""
"The saved settings are what a probe uses, not what is currently typed on the "
"Next.js API tab — save there first, then probe."
msgstr ""
"Une sonde utilise les réglages enregistrés, pas ce qui est saisi dans "
"l’onglet API Next.js — enregistrez-y d’abord, puis sondez."

#: include/Probe.php:371
msgid "Send probe"
msgstr "Envoyer la sonde"

#: include/Revalidate.php:784
#, php-format
msgid "Revalidate post “%s”"
msgstr "Revalider l’article « %s »"

#: include/Revalidate.php:785 include/Revalidate.php:978
msgid "Revalidate"
msgstr "Revalider"

#: include/Revalidate.php:826
msgid "It is no longer applied: a post change carries no permalink to rewrite."
msgstr ""
"Il n’est plus appliqué : un changement d’article ne porte aucun permalien à "
"réécrire."

#: include/Revalidate.php:872
msgid "Sorry, you are not allowed to revalidate this post."
msgstr "Désolé, vous n’êtes pas autorisé(e) à revalider cet article."

#: include/Revalidate.php:900
msgctxt "Admin top bar menu"
msgid "Revalidate this page"
msgstr "Revalider cette page"

#: include/Revalidate.php:908
msgctxt "Admin top bar menu"
msgid "Tell the front-end to revalidate the page currently being edited."
msgstr "Demander au front-end de revalider la page en cours d’édition."

#: include/Revalidate.php:1013
#, php-format
msgid "“%s”: the revalidation was sent to the front-end."
msgstr "« %s » : la revalidation a été envoyée au front-end."

#: include/Revalidate.php:1014 include/Revalidate.php:1054
msgid "Unable to revalidate. Please try again or contact an administrator."
msgstr ""
"Impossible de revalider. Veuillez réessayer ou contacter un administrateur."

#: include/Revalidate.php:1053
#, php-format
msgid "%d post: the revalidation was sent to the front-end."
msgid_plural "%d posts: the revalidation was sent to the front-end."
msgstr[0] "%d article : la revalidation a été envoyée au front-end."
msgstr[1] "%d articles : la revalidation a été envoyée au front-end."

#: include/RevalidateAll.php:53
msgctxt "Admin top bar menu"
msgid "All"
msgstr "Tout"

#: include/RevalidateAll.php:86
msgctxt "Admin top bar menu"
msgid "Tell the front-end to revalidate everything it cached from these posts."
msgstr ""
"Demander au front-end de revalider tout ce qu’il a mis en cache à partir de "
"ces articles."

#: include/RevalidateAll.php:103
msgid "Revalidate all: nothing was sent, this site is not configured."
msgstr "Tout revalider : rien n’a été envoyé, ce site n’est pas configuré."

#: include/RevalidateAll.php:113
msgid ""
"Revalidate all: nothing was sent, this site's nextjs_revalidate_change "
"filter dropped it."
msgstr ""
"Tout revalider : rien n’a été envoyé, le filtre nextjs_revalidate_change de "
"ce site l’a écarté."

#: include/RevalidateAll.php:124
msgid "Revalidate all: the revalidation was sent to the front-end."
msgstr "Tout revalider : la revalidation a été envoyée au front-end."

#: include/Settings.php:225
msgid "Next.js Revalidate settings"
msgstr "Next.js Revalidate paramètres"

#: include/Settings.php:239
msgid "Next.js API"
msgstr "Configuration de l’API Next.js"

