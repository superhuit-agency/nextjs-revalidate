#. Plugin Name of the plugin
#: nextjs-revalidate.php
msgid "Next.js Revalidate"
msgstr ""

#. Plugin URI of the plugin
#: nextjs-revalidate.php
msgid "https://github.com/superhuit-agency/nextjs-revalidate.git"
msgstr ""

#. Description of the plugin
#: nextjs-revalidate.php
msgid "Tells a Next.js front-end which WordPress content changed — posts, menus, templates, redirects — so it can revalidate whatever it cached from it, on save and from the admin."
msgstr ""

#. Author of the plugin
#: nextjs-revalidate.php
msgid "superhuit"
msgstr ""

#. Author URI of the plugin
#: nextjs-revalidate.php
msgid "https://www.superhuit.ch"
msgstr ""

