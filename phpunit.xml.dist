<?xml version="1.0" encoding="UTF-8"?>
<!--
	The integration suite: PHPUnit tests that need real WordPress state.

	Run it with `npm run test:integration`, which starts wp-env's tests
	environment and invokes this plugin's own `vendor/bin/phpunit` inside its
	containers — one version, pinned by composer.lock, rather than the container's
	global binary. Running phpunit from the host will not work: the bootstrap
	needs WP_TESTS_DIR, a database and the WordPress test library, none of which
	exist outside the container.

	Tests that need none of that are standalone scripts under tests/ and run
	with `npm run test:php`. See docs/adr/0008-two-testing-idioms.md.
-->
<phpunit
	bootstrap="tests/integration/bootstrap.php"
	colors="true"
	cacheResult="false"
	failOnWarning="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
