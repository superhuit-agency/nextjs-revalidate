{
    "name": "superhuit/nextjs-revalidate",
    "description": "Tells a Next.js front-end which WordPress content changed — posts, menus, templates, redirects — so it can revalidate whatever it cached from it, on save and from the admin.",
    "type": "wordpress-plugin",
    "keywords": ["wordpress","nextjs","cache"],
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/superhuit-agency/nextjs-revalidate",
    "authors": [
        {
            "name": "superhuit",
            "email": "tech@superhuit.ch",
            "homepage": "https://superhuit.ch",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/superhuit-agency/nextjs-revalidate/issues"
    },
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NextJsRevalidate\\Tests\\": "tests/integration/",
            "NextJsRevalidate\\PHPStan\\": "config/phpstan/"
        }
    },
    "autoload": {
        "psr-4": {
            "NextJsRevalidate\\": "include/"
        }
    },
    "require-dev": {
        "johnpbloch/wordpress-core": "6.1",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "require": {
        "kuuak/wordpress-setting-fields": "^1.1"
    }
}
